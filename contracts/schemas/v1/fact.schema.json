{
  "$defs": {
    "ComparisonDetail": {
      "additionalProperties": false,
      "description": "Required on ``comparison`` facts; computed by code, never the model.",
      "properties": {
        "difference": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Difference"
        },
        "difference_unit": {
          "$ref": "#/$defs/Unit"
        },
        "left_fact_id": {
          "pattern": "^F_[0-9a-f]{16}$",
          "title": "Left Fact Id",
          "type": "string"
        },
        "matching_keys": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Matching Keys",
          "type": "array"
        },
        "ratio": {
          "anyOf": [
            {
              "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ratio"
        },
        "relation": {
          "$ref": "#/$defs/Relation"
        },
        "right_fact_id": {
          "pattern": "^F_[0-9a-f]{16}$",
          "title": "Right Fact Id",
          "type": "string"
        }
      },
      "required": [
        "left_fact_id",
        "right_fact_id",
        "matching_keys",
        "relation",
        "difference",
        "ratio",
        "difference_unit"
      ],
      "title": "ComparisonDetail",
      "type": "object"
    },
    "CoverageStatus": {
      "description": "Daily exports cannot prove completeness, so nothing is ever ``complete``.",
      "enum": [
        "unverified",
        "possibly_incomplete",
        "insufficient_data",
        "externally_verified"
      ],
      "title": "CoverageStatus",
      "type": "string"
    },
    "Dimension": {
      "description": "The five approved segment dimensions; also the drill-down ``by`` values.",
      "enum": [
        "supply_id",
        "country",
        "size",
        "placement_type",
        "device_type"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "FactKind": {
      "enum": [
        "measured",
        "calculated",
        "comparison",
        "quality",
        "scenario"
      ],
      "title": "FactKind",
      "type": "string"
    },
    "InputColumn": {
      "description": "The 17 required header names of the daily export, in file order.",
      "enum": [
        "Day",
        "Supply ID",
        "Country",
        "Size",
        "Placement Type",
        "Device Type",
        "Demand Requests",
        "Demand Responses",
        "Our Bidfloor",
        "Demand Bidprice",
        "Demand sRPM $",
        "Demand Wins",
        "Supply Impressions",
        "Revenue",
        "Cost",
        "Demand eCPM",
        "Profit $"
      ],
      "title": "InputColumn",
      "type": "string"
    },
    "MetricKey": {
      "description": "Metric identifiers carried by facts. Rates are always ratios of sums.",
      "enum": [
        "requests",
        "responses",
        "wins",
        "impressions",
        "revenue",
        "cost",
        "profit",
        "response_rate",
        "win_rate",
        "impression_to_win_rate",
        "ecpm",
        "revenue_per_million_requests",
        "profit_per_million_requests",
        "margin",
        "request_share",
        "revenue_share",
        "profit_share",
        "request_weighted_floor",
        "response_weighted_bid",
        "daily_change",
        "profit_reconciliation_residual",
        "reconciliation_bound",
        "row_count",
        "row_share",
        "impression_share",
        "observed_days",
        "revenue_positive_days",
        "missing_days",
        "day_request_ratio",
        "day_revenue_ratio",
        "slice_drop_share",
        "adjacent_day_yield_ratio",
        "max_day_revenue_share",
        "top_two_day_revenue_share",
        "max_day_profit_share",
        "top_two_day_profit_share",
        "srpm_match_share",
        "srpm_error_ratio",
        "ecpm_mismatch_share",
        "counter_granularity",
        "granularity_coverage",
        "zero_bid_response_share",
        "bid_below_floor_response_share",
        "zero_floor_request_share"
      ],
      "title": "MetricKey",
      "type": "string"
    },
    "Period": {
      "additionalProperties": false,
      "properties": {
        "coverage_status": {
          "$ref": "#/$defs/CoverageStatus"
        },
        "end": {
          "format": "date",
          "title": "End",
          "type": "string"
        },
        "included_dates": {
          "items": {
            "format": "date",
            "type": "string"
          },
          "title": "Included Dates",
          "type": "array"
        },
        "period_id": {
          "pattern": "^P_[0-9a-f]{16}$",
          "title": "Period Id",
          "type": "string"
        },
        "start": {
          "format": "date",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "period_id",
        "start",
        "end",
        "included_dates",
        "coverage_status"
      ],
      "title": "Period",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "aggregation_keys": {
          "items": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Aggregation Keys",
          "type": "array"
        },
        "formula_id": {
          "pattern": "^[a-z0-9_]+_v[0-9]+$",
          "title": "Formula Id",
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Sha256",
          "type": "string"
        },
        "parent_fact_ids": {
          "items": {
            "pattern": "^F_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Parent Fact Ids",
          "type": "array"
        },
        "quality_issue_ids": {
          "items": {
            "pattern": "^Q_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Quality Issue Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_columns": {
          "items": {
            "$ref": "#/$defs/InputColumn"
          },
          "title": "Source Columns",
          "type": "array"
        },
        "source_line_ranges_ref": {
          "pattern": "^private_rows_[0-9a-f]{16}$",
          "title": "Source Line Ranges Ref",
          "type": "string"
        },
        "source_row_set_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Row Set Hash",
          "type": "string"
        },
        "weighting": {
          "$ref": "#/$defs/Weighting"
        }
      },
      "required": [
        "input_sha256",
        "formula_id",
        "source_columns",
        "source_row_set_hash",
        "source_line_ranges_ref",
        "parent_fact_ids",
        "aggregation_keys",
        "weighting",
        "quality_issue_ids"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Relation": {
      "description": "Direction of a comparison fact, computed by code.",
      "enum": [
        "greater",
        "less",
        "equal",
        "undefined"
      ],
      "title": "Relation",
      "type": "string"
    },
    "Segment": {
      "additionalProperties": false,
      "description": "An observed group. ``filters`` hold raw labels and are private data.",
      "properties": {
        "cohort_id": {
          "default": "full_input",
          "maxLength": 64,
          "minLength": 1,
          "title": "Cohort Id",
          "type": "string"
        },
        "filters": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "$ref": "#/$defs/Dimension"
          },
          "title": "Filters",
          "type": "object"
        },
        "segment_id": {
          "pattern": "^G_[0-9a-f]{16}$",
          "title": "Segment Id",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "filters"
      ],
      "title": "Segment",
      "type": "object"
    },
    "Unit": {
      "description": "Units of fact and assumption values. No ISO currency is ever asserted.",
      "enum": [
        "count",
        "fraction",
        "ratio",
        "export_dollar",
        "export_dollar_per_thousand_impressions",
        "export_dollar_per_million_requests",
        "export_price_as_exported",
        "percentage_points",
        "days"
      ],
      "title": "Unit",
      "type": "string"
    },
    "Validity": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "$ref": "#/$defs/ValidityStatus"
        }
      },
      "required": [
        "status"
      ],
      "title": "Validity",
      "type": "object"
    },
    "ValidityStatus": {
      "enum": [
        "valid",
        "undefined",
        "invalid",
        "tainted"
      ],
      "title": "ValidityStatus",
      "type": "string"
    },
    "Weighting": {
      "enum": [
        "sum",
        "ratio_of_sums",
        "request_weighted",
        "response_weighted",
        "not_applicable"
      ],
      "title": "Weighting",
      "type": "string"
    }
  },
  "$id": "adops-optimizer/contracts/v1/fact.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "comparison": {
      "anyOf": [
        {
          "$ref": "#/$defs/ComparisonDetail"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fact_id": {
      "pattern": "^F_[0-9a-f]{16}$",
      "title": "Fact Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/FactKind"
    },
    "metric": {
      "$ref": "#/$defs/MetricKey"
    },
    "period": {
      "$ref": "#/$defs/Period"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "run_namespace": {
      "pattern": "^N_[0-9a-f]{16}$",
      "title": "Run Namespace",
      "type": "string"
    },
    "segment": {
      "$ref": "#/$defs/Segment"
    },
    "unit": {
      "$ref": "#/$defs/Unit"
    },
    "validity": {
      "$ref": "#/$defs/Validity"
    },
    "value": {
      "anyOf": [
        {
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Value"
    }
  },
  "required": [
    "fact_id",
    "run_namespace",
    "kind",
    "segment",
    "period",
    "metric",
    "value",
    "unit",
    "validity",
    "provenance"
  ],
  "title": "Fact",
  "type": "object",
  "x-schema-version": "1"
}
