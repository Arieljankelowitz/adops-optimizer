{
  "$defs": {
    "BreakdownArgs": {
      "additionalProperties": false,
      "properties": {
        "by": {
          "$ref": "#/$defs/Dimension"
        },
        "limit": {
          "default": 10,
          "maximum": 25,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "period_id": {
          "pattern": "^P_[0-9a-f]{16}$",
          "title": "Period Id",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^G_[0-9a-f]{16}$",
          "title": "Segment Id",
          "type": "string"
        },
        "tool": {
          "const": "breakdown",
          "default": "breakdown",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "by",
        "period_id"
      ],
      "title": "BreakdownArgs",
      "type": "object"
    },
    "CandidateRecommendation": {
      "additionalProperties": false,
      "description": "The model's per-candidate output: references and codes only.",
      "properties": {
        "assumption_ids": {
          "items": {
            "pattern": "^A_[0-9a-f]{16}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Assumption Ids",
          "type": "array"
        },
        "candidate_id": {
          "pattern": "^C_[0-9a-f]{16}$",
          "title": "Candidate Id",
          "type": "string"
        },
        "confidence_in_observation": {
          "$ref": "#/$defs/Confidence"
        },
        "counter_evidence_fact_ids": {
          "items": {
            "pattern": "^F_[0-9a-f]{16}$",
            "type": "string"
          },
          "maxItems": 12,
          "title": "Counter Evidence Fact Ids",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "hypothesis_codes": {
          "items": {
            "$ref": "#/$defs/HypothesisCode"
          },
          "maxItems": 4,
          "title": "Hypothesis Codes",
          "type": "array"
        },
        "merge_source_candidate_ids": {
          "items": {
            "pattern": "^C_[0-9a-f]{16}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Merge Source Candidate Ids",
          "type": "array"
        },
        "observation_statements": {
          "items": {
            "$ref": "#/$defs/ObservationStatement"
          },
          "maxItems": 8,
          "title": "Observation Statements",
          "type": "array"
        },
        "origin": {
          "default": "detector",
          "enum": [
            "detector",
            "model_proposed"
          ],
          "title": "Origin",
          "type": "string"
        },
        "overlap_group_ids": {
          "items": {
            "pattern": "^O_[0-9a-f]{16}$",
            "type": "string"
          },
          "title": "Overlap Group Ids",
          "type": "array"
        },
        "period_id": {
          "pattern": "^P_[0-9a-f]{16}$",
          "title": "Period Id",
          "type": "string"
        },
        "prerequisite_codes": {
          "items": {
            "$ref": "#/$defs/PrerequisiteCode"
          },
          "maxItems": 7,
          "title": "Prerequisite Codes",
          "type": "array"
        },
        "risk_codes": {
          "items": {
            "$ref": "#/$defs/RiskCode"
          },
          "maxItems": 7,
          "title": "Risk Codes",
          "type": "array"
        },
        "scenario_ids": {
          "items": {
            "pattern": "^S_[0-9a-f]{16}$",
            "type": "string"
          },
          "maxItems": 4,
          "title": "Scenario Ids",
          "type": "array"
        },
        "segment_id": {
          "pattern": "^G_[0-9a-f]{16}$",
          "title": "Segment Id",
          "type": "string"
        },
        "success_metric_keys": {
          "items": {
            "$ref": "#/$defs/MetricKey"
          },
          "maxItems": 4,
          "title": "Success Metric Keys",
          "type": "array"
        },
        "test_template_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TestTemplateId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate_id",
        "decision",
        "segment_id",
        "period_id",
        "observation_statements",
        "counter_evidence_fact_ids",
        "hypothesis_codes",
        "test_template_id",
        "assumption_ids",
        "scenario_ids",
        "prerequisite_codes",
        "risk_codes",
        "success_metric_keys",
        "confidence_in_observation",
        "overlap_group_ids"
      ],
      "title": "CandidateRecommendation",
      "type": "object"
    },
    "CompareToPeersArgs": {
      "additionalProperties": false,
      "properties": {
        "peer_definition_id": {
          "pattern": "^D_[0-9a-f]{16}$",
          "title": "Peer Definition Id",
          "type": "string"
        },
        "period_id": {
          "pattern": "^P_[0-9a-f]{16}$",
          "title": "Period Id",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^G_[0-9a-f]{16}$",
          "title": "Segment Id",
          "type": "string"
        },
        "tool": {
          "const": "compare_to_peers",
          "default": "compare_to_peers",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "period_id",
        "peer_definition_id"
      ],
      "title": "CompareToPeersArgs",
      "type": "object"
    },
    "Confidence": {
      "description": "Confidence in the observed pattern, not in an intervention's effect.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DailyTrendArgs": {
      "additionalProperties": false,
      "properties": {
        "period_id": {
          "pattern": "^P_[0-9a-f]{16}$",
          "title": "Period Id",
          "type": "string"
        },
        "segment_id": {
          "pattern": "^G_[0-9a-f]{16}$",
          "title": "Segment Id",
          "type": "string"
        },
        "tool": {
          "const": "daily_trend",
          "default": "daily_trend",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "segment_id",
        "period_id"
      ],
      "title": "DailyTrendArgs",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "recommend_test",
        "investigate_first",
        "reject",
        "merge"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Dimension": {
      "description": "The five approved segment dimensions; also the drill-down ``by`` values.",
      "enum": [
        "supply_id",
        "country",
        "size",
        "placement_type",
        "device_type"
      ],
      "title": "Dimension",
      "type": "string"
    },
    "HypothesisCode": {
      "enum": [
        "traffic_mix_or_configuration_unverified",
        "demand_quality_or_mix_unverified",
        "floor_setting_unverified",
        "rendering_or_counting_defect_unverified",
        "commercial_terms_unverified",
        "export_semantics_unverified",
        "one_off_event_unverified"
      ],
      "title": "HypothesisCode",
      "type": "string"
    },
    "MetricKey": {
      "description": "Metric identifiers carried by facts. Rates are always ratios of sums.",
      "enum": [
        "requests",
        "responses",
        "wins",
        "impressions",
        "revenue",
        "cost",
        "profit",
        "response_rate",
        "win_rate",
        "impression_to_win_rate",
        "ecpm",
        "revenue_per_million_requests",
        "profit_per_million_requests",
        "margin",
        "request_share",
        "revenue_share",
        "profit_share",
        "request_weighted_floor",
        "response_weighted_bid",
        "response_weighted_floor",
        "daily_change",
        "profit_reconciliation_residual",
        "reconciliation_bound",
        "row_count",
        "row_share",
        "impression_share",
        "observed_days",
        "revenue_positive_days",
        "missing_days",
        "day_request_ratio",
        "day_revenue_ratio",
        "slice_drop_share",
        "adjacent_day_yield_ratio",
        "max_day_revenue_share",
        "top_two_day_revenue_share",
        "max_day_profit_share",
        "top_two_day_profit_share",
        "srpm_match_share",
        "srpm_error_ratio",
        "ecpm_mismatch_share",
        "counter_granularity",
        "granularity_coverage",
        "zero_bid_response_share",
        "bid_below_floor_response_share",
        "zero_floor_request_share"
      ],
      "title": "MetricKey",
      "type": "string"
    },
    "NextStepKind": {
      "enum": [
        "call_tool",
        "final"
      ],
      "title": "NextStepKind",
      "type": "string"
    },
    "ObservationStatement": {
      "additionalProperties": false,
      "properties": {
        "fact_ids": {
          "items": {
            "pattern": "^F_[0-9a-f]{16}$",
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "template_id": {
          "$ref": "#/$defs/ObservationTemplateId"
        }
      },
      "required": [
        "template_id",
        "fact_ids"
      ],
      "title": "ObservationStatement",
      "type": "object"
    },
    "ObservationTemplateId": {
      "enum": [
        "metric_value",
        "metric_vs_baseline",
        "trend",
        "coverage",
        "concentration"
      ],
      "title": "ObservationTemplateId",
      "type": "string"
    },
    "PrerequisiteCode": {
      "enum": [
        "confirm_eligible_inventory",
        "confirm_capacity",
        "confirm_contract_terms",
        "reconcile_counters_with_logs",
        "obtain_bid_distributions",
        "confirm_export_semantics",
        "establish_concurrent_holdout"
      ],
      "title": "PrerequisiteCode",
      "type": "string"
    },
    "RiskCode": {
      "enum": [
        "demand_saturation",
        "displaced_profit_unknown",
        "revenue_at_risk",
        "partner_relationship",
        "measurement_noise",
        "one_off_concentration",
        "counter_semantics_unknown"
      ],
      "title": "RiskCode",
      "type": "string"
    },
    "TestTemplateId": {
      "enum": [
        "matched_allocation_holdout",
        "targeted_throttle_holdout",
        "floor_increase_randomized",
        "floor_decrease_randomized",
        "commercial_terms_review",
        "counter_reconciliation",
        "instrumentation_feasibility"
      ],
      "title": "TestTemplateId",
      "type": "string"
    }
  },
  "$id": "adops-optimizer/contracts/v1/next_step.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Parser-independent tool loop turn: call one tool or return a final answer.",
  "properties": {
    "kind": {
      "$ref": "#/$defs/NextStepKind"
    },
    "recommendation": {
      "anyOf": [
        {
          "$ref": "#/$defs/CandidateRecommendation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "tool_call": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "breakdown": "#/$defs/BreakdownArgs",
              "compare_to_peers": "#/$defs/CompareToPeersArgs",
              "daily_trend": "#/$defs/DailyTrendArgs"
            },
            "propertyName": "tool"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BreakdownArgs"
            },
            {
              "$ref": "#/$defs/DailyTrendArgs"
            },
            {
              "$ref": "#/$defs/CompareToPeersArgs"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Call"
    }
  },
  "required": [
    "kind"
  ],
  "title": "NextStep",
  "type": "object",
  "x-schema-version": "1"
}
